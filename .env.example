# LeadFlow AI Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.

PROJECT_NAME=LeadFlow AI
ENVIRONMENT=development

# --- External CRM & Sheet Storage ---
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# --- Webhook Authentication (Server-to-Server) ---
WEBHOOK_SECRET=your_high_entropy_webhook_secret_here

# --- AI Provider Configuration ---
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30000
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=2048

# --- Gmail Integration ---
GMAIL_CLIENT_SECRET_FILE=credentials/gmail_oauth_client.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json
GMAIL_REDIRECT_URI=http://localhost:8001/api/v1/gmail/oauth/callback
GMAIL_SENDER_EMAIL=your_email@gmail.com
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_INTERVAL_SECONDS=300
GMAIL_SYNC_BATCH_SIZE=50
GMAIL_SYNC_MAX_PAGES=5
GMAIL_DB_FILE=credentials/gmail_inbox.sqlite3
GMAIL_INTELLIGENCE_DB_FILE=credentials/gmail_intelligence.sqlite3
GMAIL_INTELLIGENCE_BATCH_SIZE=20
GMAIL_INTELLIGENCE_MAX_BATCH_SIZE=100
GMAIL_INTELLIGENCE_MAX_BODY_CHARS=12000

# --- Automation Engine ---
AUTOMATION_DB_FILE=credentials/automation.sqlite3
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_POLL_INTERVAL_SECONDS=10
AUTOMATION_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Phase 7 Dashboard & Security ---
DASHBOARD_USERNAME=admin
# In development, a fallback password is used if unset.
# In production, DASHBOARD_PASSWORD (secure non-default) or DASHBOARD_PASSWORD_HASH is REQUIRED.
DASHBOARD_PASSWORD=admin123
# DASHBOARD_PASSWORD_HASH=salt$hash

# In production, SESSION_SECRET_KEY is REQUIRED and must be a unique, random string (min 32 chars).
SESSION_SECRET_KEY=your_random_32_char_session_secret_key_here
SESSION_COOKIE_NAME=leadflow_session
SESSION_MAX_AGE_SECONDS=86400

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse Proxy Trust (set true ONLY when deployed behind Nginx/Caddy on localhost)
TRUST_PROXY_HEADERS=false
